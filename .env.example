# Example configuration. Copy to .env and fill in the real values.
# The .env file must never be added to the repository.

# Environment: development, staging, production
ENVIRONMENT=development

# Database (application user, no permissions on the schema)
DATABASE_URL=postgresql+psycopg://sportlab_dev_app:CHANGE_ME@localhost:5432/sportlab_dev
# Database for migrations (schema owner user)
DATABASE_MIGRATION_URL=postgresql+psycopg://sportlab_dev_migrator:CHANGE_ME@localhost:5432/sportlab_dev

# Security
SECRET_KEY=CHANGE_ME
# Key used to encrypt the Garmin keys stored in the database
ENCRYPTION_KEY=CHANGE_ME

# Google login (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google email of the administrator account (a dedicated address is
# recommended, not a personal one). The admin role is assigned at the first
# login with this address; there is no default administrator in the code.
ADMIN_EMAIL=

# Token lifetimes (minutes and days)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
