# Esempio di configurazione. Copia in .env e inserisci i valori reali.
# Il file .env non va mai aggiunto al repository.

# Ambiente: development, staging, production
ENVIRONMENT=development

# Database (utente applicazione, senza permessi sulla struttura)
DATABASE_URL=postgresql+psycopg://sportlab_dev_app:CAMBIAMI@localhost:5432/sportlab_dev
# Database per le migrazioni (utente proprietario dello schema)
DATABASE_MIGRATION_URL=postgresql+psycopg://sportlab_dev_migrator:CAMBIAMI@localhost:5432/sportlab_dev

# Sicurezza
SECRET_KEY=CAMBIAMI
# Chiave per cifrare le chiavi Garmin salvate nel database
ENCRYPTION_KEY=CAMBIAMI

# Login con Google (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Google dell'amministratore creato dal seeding
ADMIN_EMAIL=

# Durata dei token (minuti e giorni)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
